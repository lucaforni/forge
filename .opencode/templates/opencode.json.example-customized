{
  "$schema": "https://opencode.ai/config.json",
  // FORGE - Customized for My Project (native OpenCode v2 shape)

  // User changed default model to Opus
  "model": "github-copilot/claude-opus-4.6",

  // User added custom thinking budgets
  "providers": {
    "github-copilot": {
      "models": {
        "claude-opus-4.6": {
          "settings": {
            "thinking": { "budgetTokens": 20000 }  // User increased
          }
        },
        "claude-sonnet-4.5": {
          "settings": {
            "thinking": { "budgetTokens": 10000 }  // User increased
          }
        }
      }
    }
  },

  // User removed some agent overrides
  "agents": {
    "forge-reviewer": {
      "model": "github-copilot/claude-opus-4.6"
    }
  },

  // User added custom shell permissions. V2 evaluates in order and the LAST
  // matching rule wins, so the broad `ask` comes first, exceptions after it.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "npx *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "yarn *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "rm -f *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },

    // User added custom docker permissions
    { "action": "shell", "resource": "docker ps", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker exec *", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" }
  ],

  // User customized instructions
  "instructions": [
    ".forge/constitution.md",
    ".forge/knowledge/decision-log.md",
    "docs/STYLE_GUIDE.md"  // User added custom doc
  ],

  // User kept MCP config as-is
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
        }
      }
    }
  }
}
