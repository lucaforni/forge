{
  "$schema": "https://opencode.ai/config.json",

  // ═══════════════════════════════════════════════════════════════════════════
  // FORGE — Framework for Orchestrated Requirements, Governance & Engineering
  //
  // This is the FALLBACK template. During installation, FORGE generates a
  // customized opencode.json based on your selected model provider.
  //
  // Supported providers: github-copilot, opencode-anthropic, opencode-deepseek, opencode-free, openai, google
  //
  // Native OpenCode v2 shape: `agents` (plural), `permissions[]`,
  // `providers` (plural), `mcp.servers`. V1 files still load via
  // normalization, but new files should use this shape.
  //
  // To reconfigure models after install:
  //   npx tsx install-forge.ts . --reconfigure
  //
  // For manual customization, edit the "model", "providers", and "agents"
  // sections below. See: .opencode/docs/FORGE-CUSTOMIZATION.md
  // ═══════════════════════════════════════════════════════════════════════════

  // Default model for all agents unless overridden
  "model": "github-copilot/claude-sonnet-4.6",

  // Default agent - FORGE orchestrator handles all workflow routing
  "default_agent": "forge",

  // Provider configuration with thinking budgets
  // claude-opus-4.7 is the default for reasoning-heavy agents
  // claude-opus-4.6 remains available on GitHub Copilot Business/Enterprise accounts
  // NOTE: Model IDs (e.g., claude-opus-4.7) are provider identifiers — replace
  // with your preferred models when customizing.
  "providers": {
    "github-copilot": {
      "models": {
        // claude-opus-4.7 is a reasoning-native model (temperature: false).
        // It does NOT accept external thinking parameters — reasoning is built-in.
        "claude-opus-4.7": {},
        "claude-opus-4.6": {
          "settings": {
            "thinking": { "budgetTokens": 16000 }
          }
        },
        "claude-sonnet-4.6": {}
      }
    }
  },

  // Agent model overrides — assign specific models to each agent role
  // Default: claude-opus-4.7 (highest quality reasoning)
  // Fallback: claude-opus-4.6 (GitHub Copilot Business/Enterprise)
  //
  // GITHUB COPILOT BUSINESS/ENTERPRISE FALLBACK:
  // If claude-opus-4.7 is not yet available on your account, uncomment the
  // section below to override agents to use claude-opus-4.6, which is still
  // available on Business and Enterprise accounts:
  //
  // "forge-pm":        { "model": "github-copilot/claude-opus-4.6" },
  // "forge-architect": { "model": "github-copilot/claude-opus-4.6" },
  // "forge-reviewer":  { "model": "github-copilot/claude-opus-4.6" },
  // "forge-ux":        { "model": "github-copilot/claude-opus-4.6" }
  "agents": {
    "forge-pm": {
      "model": "github-copilot/claude-opus-4.7"
    },
    "forge-architect": {
      "model": "github-copilot/claude-opus-4.7"
    },
    "forge-reviewer": {
      "model": "github-copilot/claude-opus-4.7"
    }
  },

  // Global tool permissions. V2 evaluates the array in order and the LAST
  // matching rule wins, so the broad `ask` comes first and the specific
  // `allow` exceptions follow it.
  "permissions": [
    // Everything else asks
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Shell operations
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "npx *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "yarn *", "effect": "allow" },

    // Safe read operations
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },

    // Build and test operations
    { "action": "shell", "resource": "make *", "effect": "allow" },

    // Directory and file operations
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },

    // Echo and output
    { "action": "shell", "resource": "echo *", "effect": "allow" },

    // File operation tool permissions (`edit` covers the old `write`)
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" }
  ],

  // Constitution and knowledge base. Retained for OpenCode v1 compatibility:
  // v2 accepts this key but does not resolve its entries. On v2 the
  // session-knowledge plugin loads these files through a context hook.
  "instructions": [
    ".forge/constitution.md",
    ".forge/knowledge/decision-log.md"
  ],

  // MCP server integrations
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
        }
      }
    }
  }
}
