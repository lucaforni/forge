{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "installer/**/*.ts",
    "mcp-server/**/*.ts",
    "tests/**/*.ts",
    "install-forge.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
