# Smoke-test credentials (level 3 harness tests). NEVER commit real values.
# Local: cp .env.example .env  (or export NVIDIA_API_KEY in your shell)
# CI:    Environment `smoke` with secret NVIDIA_API_KEY (never on PRs).

# NGC personal key from https://build.nvidia.com (free inference credits)
NVIDIA_API_KEY=nvapi-...

# Optional overrides (defaults shown)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_SMOKE_MODEL=openai/gpt-oss-20b
