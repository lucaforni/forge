{
  "$schema": "https://opencode.ai/config.json",
  // FORGE - Framework for Orchestrated Requirements, Governance & Engineering
  // Full project configuration for OpenCode (native v2 shape)

  // Default model for all agents unless overridden
  "model": "github-copilot/claude-sonnet-5.5",

  // Maximum subagent nesting depth. OpenCode defaults to 1 (subagents
  // cannot launch subagents); FORGE needs 5 for orchestrator fan-out
  // (e.g. parallel dual-model review with delegated subtasks).
  // Cost note: each extra level multiplies token spend and latency —
  // lower it (even to 0) if runs get expensive. Reconfigurable per
  // project — the installer never overrides an explicit value.
  "subagent_depth": 5,

  // Default agent - FORGE orchestrator handles all workflow routing
  "default_agent": "forge",

  // Provider configuration with thinking budgets
  // claude-opus-4.8 is the default for reasoning-heavy agents
  // claude-opus-4.8-fast is available as a lower-cost reasoning fallback
  "providers": {
    "github-copilot": {
      "models": {
        // claude-opus-4.8 is a reasoning-native model (temperature: false).
        // It does NOT accept external thinking parameters — reasoning is built-in.
        "claude-opus-4.8": {},
        "claude-opus-4.8-fast": {},
        "claude-sonnet-5.5": {}
      }
    }
  },

  // Agent model overrides — assign specific models to each agent role
  // Default: claude-opus-4.8 (highest quality reasoning)
  // Fallback: claude-opus-4.8-fast (lower-cost reasoning)
  // NOTE: For FORGE meta-development, we override agent paths to use meta versions
  //
  // GITHUB COPILOT FALLBACK:
  // If claude-opus-4.8 is not yet available on your account, override agents
  // to use claude-opus-4.8-fast:
  //
  //   "forge-pm":        { "model": "github-copilot/claude-opus-4.8-fast", "path": "..." }
  //   "forge-architect": { "model": "github-copilot/claude-opus-4.8-fast", "path": "..." }
  //   "forge-reviewer":  { "model": "github-copilot/claude-opus-4.8-fast" }
  //   "forge-ux":        { "model": "github-copilot/claude-opus-4.8-fast" }
  "agents": {
    "forge-pm": {
      "model": "github-copilot/claude-opus-4.8",
      "path": ".opencode-meta/agents/forge-pm-meta.md"
    },
    "forge-architect": {
      "model": "github-copilot/claude-opus-4.8",
      "path": ".opencode-meta/agents/forge-architect-meta.md"
    },
    "forge-scrum": {
      "model": "github-copilot/claude-sonnet-5.5",
      "path": ".opencode-meta/agents/forge-scrum-meta.md"
    },
    "forge-reviewer": {
      "model": "github-copilot/claude-opus-4.8"
    }
  },

  // Global tool permissions. V2 evaluates in order and the LAST matching
  // rule wins. This dogfooding config allows every shell command (`*`
  // catch-all below); user projects get the conservative seed from the
  // installer instead.
  "permissions": [
    // Git operations
    { "action": "shell", "resource": "git *", "effect": "allow" },

    // NPM/Node operations
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "npx *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "yarn *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "bun *", "effect": "allow" },

    // Safe read operations
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },

    // Build and test operations
    { "action": "shell", "resource": "make *", "effect": "allow" },

    // Directory and file operations
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "rm -f *", "effect": "allow" },

    // Echo and output
    { "action": "shell", "resource": "echo *", "effect": "allow" },

    // Everything else (dogfooding: allow)
    { "action": "shell", "resource": "*", "effect": "allow" },

    // File operation tool permissions (`edit` covers the old `write`)
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    // ...except secrets: re-assert the `.env` guard the broad allow above
    // would otherwise swallow (last-match-wins over the base policy).
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" }
  ],

  // Constitution and knowledge base for FORGE meta-development
  "instructions": [
    ".forge-meta/constitution.md",
    ".forge-meta/knowledge/decision-log.md"
  ],

  // MCP server integrations
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
        }
      }
    }
  }
}
